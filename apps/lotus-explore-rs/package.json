{
  "name": "lotus-explore-rs",
  "private": true,
  "browserslist": [
    "chrome >= 100",
    "firefox >= 100",
    "safari >= 15"
  ],
  "scripts": {
    "dev": "dx serve --package lotus-explore-rs --platform web --locked --open=false",
    "build:release": "npm run build:css --silent && BROWSERSLIST='chrome >= 100, firefox >= 100, safari >= 15' dx build --package lotus-explore-rs --platform web --release --debug-symbols=false --locked --rustc-args=-Copt-level=z",
    "build:css": "npx @tailwindcss/cli@4.3.3 -i ./tailwind/styles.css -o ./public/assets/lotus-explore.css --minify && node -e \"const fs=require('fs');const p='public/assets/lotus-explore.css';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replaceAll('-webkit-text-size-adjust:100%','text-size-adjust:100%'));\"",
    "watch:css": "npx @tailwindcss/cli@4.3.3 -i ./tailwind/styles.css -o ./public/assets/lotus-explore.css --minify --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
